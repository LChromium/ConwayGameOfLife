:root {
    --background: rgb(41, 43, 48);
    --ink: rgb(39, 43, 43);
    --metal: rgb(104, 119, 113);
    --metal-dark: rgb(65, 73, 66);
    --paper: rgb(214, 213, 187);
    --mint: rgb(159, 197, 175);
    --amber: rgb(219, 187, 121);
}

.app {
    flex-grow: 1;
    background-color: var(--background);
    color: var(--paper);
    padding: 18px 32px 14px;
}

.header, .top-line, .screen-bar, .readouts, .controls, .footer, .workspace {
    flex-direction: row;
}

.header { height: 64px; flex-shrink: 0; align-items: center; justify-content: space-between; }
.title { font-size: 22px; color: rgb(225, 225, 205); }
.serial, .micro, .archive-note, .field-label, .readout-caption, .footer-text { font-size: 10px; }
.serial { color: rgb(155, 164, 155); margin-top: 4px; }
.status { color: var(--mint); font-size: 11px; }

/* 300px is derived from the vertical budget, not guessed:
     reference height 900
       - app padding (18 + 14)           =  32
       - header 64 + footer 36           = 100
       - machine borders (2 + 9)         =  11
     => machine may occupy at most 778px.
   Its floor must stay under the *visible* panel height on a 1280x720 window (854px), which
   leaves 854 - 100 - 32 - 11 = 711px of slack; 300px keeps ~400px of headroom for the footer. */
.machine {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 300px;
    background-color: var(--metal);
    border-width: 2px 2px 9px 2px;
    border-color: rgb(141, 147, 136) rgb(141, 147, 136) var(--metal-dark) rgb(141, 147, 136);
    padding: 14px 22px 14px;
}

.top-line { height: 28px; flex-shrink: 0; justify-content: space-between; color: rgb(38, 55, 48); }
.workspace { flex-grow: 1; }
.display {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 420px;
    background-color: rgb(38, 42, 42);
    border-width: 8px;
    border-color: rgb(65, 75, 71);
    margin-right: 20px;
}
.screen-bar { height: 30px; flex-shrink: 0; justify-content: space-between; align-items: center; padding: 0 14px; color: rgb(178, 193, 168); border-bottom-width: 1px; border-bottom-color: rgb(81, 99, 86); }
.life-grid { flex-grow: 1; min-height: 96px; }
.readouts { height: 74px; flex-shrink: 0; border-top-width: 1px; border-top-color: rgb(81, 99, 86); padding: 10px 16px 0; }
.readout { min-width: 155px; margin-right: 24px; }
.readout-caption { color: rgb(139, 158, 141); font-size: 11px; }
.readout-value { color: rgb(221, 209, 162); font-size: 24px; margin-top: 6px; }
.readout-value-compact { color: rgb(221, 209, 162); font-size: 16px; margin-top: 10px; }

/* 280 rather than 236: the backend selector has to show "GPU（Compute Shader）", which measures
   165 units of text. The popup spends 82 of its width on the arrow and padding, so a 236-unit
   column left the text box at 154 and the name was cut to "GPU（Compute Shade" in the capture.
   The 44 units come out of the display, which is still 1188 units wide for a 256-cell board. */
.library { width: 280px; flex-shrink: 0; color: rgb(34, 47, 42); }
.section-title { font-size: 14px; flex-shrink: 0; margin-bottom: 4px; }
.archive-note { color: rgb(51, 70, 61); flex-shrink: 0; margin-bottom: 8px; }

/* The tool area is two pages behind a tab strip rather than one ever-growing
   column. Stacking the archive and the seeding panel in the same 236-unit column
   left the archive showing three of eight specimens, and in the stacked layout the
   combined content overflowed the machine and overlapped the board. */
.tool-tabs { flex-direction: row; flex-shrink: 0; margin-bottom: 6px; }
.tool-tab {
    flex-grow: 1;
    height: 26px;
    margin: 0 4px 0 0;
    font-size: 11px;
    background-color: rgb(62, 74, 70);
    color: rgb(200, 205, 185);
    border-width: 1px 1px 3px 1px;
    border-color: rgb(120, 130, 120) rgb(120, 130, 120) rgb(48, 56, 53) rgb(120, 130, 120);
    border-radius: 3px;
}
.tool-tab:hover { background-color: rgb(78, 92, 87); }
.tool-tab-active {
    background-color: rgb(195, 189, 150);
    color: rgb(43, 58, 48);
    border-color: rgb(225, 217, 177) rgb(225, 217, 177) rgb(125, 129, 106) rgb(225, 217, 177);
}

/* Both pages are direct children of the column and take the space between the tab
   strip and the shared boundary/backend controls. The archive manages its own
   overflow; the seeding page scrolls because in the stacked layout it wraps. */
.tool-page { flex-grow: 1; flex-shrink: 1; min-height: 96px; flex-direction: column; }

/* The archive is the one region that may not fit on a short window. Rather than letting it push
   the machine past the reference height (which clipped the controls at 1280x720), it scrolls. */
.preset-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 96px;
    margin-bottom: 2px;
}

.preset {
    height: 46px;
    flex-shrink: 0;
    margin-bottom: 5px;
    padding: 5px 12px;
    background-color: rgb(79, 92, 85);
    border-width: 1px 1px 4px 1px;
    border-color: rgb(132, 144, 132) rgb(132, 144, 132) rgb(52, 61, 58) rgb(132, 144, 132);
    border-radius: 3px;
    color: rgb(220, 221, 196);
    font-size: 11px;
    -unity-text-align: middle-left;
}
.preset:hover { background-color: rgb(92, 106, 97); }
.preset.selected { background-color: rgb(195, 189, 150); color: rgb(43, 58, 48); border-color: rgb(225, 217, 177) rgb(225, 217, 177) rgb(125, 129, 106) rgb(225, 217, 177); }
.field-label { margin-top: 11px; margin-bottom: 5px; flex-shrink: 0; }
/* The dropdown previously rendered as light text on a light field, which read as a disabled
   control. It now uses the same dark-well treatment as the readouts. The inner text element is
   styled too: the background/color on the field alone does not reach it in UI Toolkit. */
.dropdown { height: 34px; flex-shrink: 0; background-color: rgb(38, 42, 42); border-width: 1px; border-color: rgb(141, 153, 140); }
.dropdown .unity-base-field__label,
.dropdown .unity-base-popup-field__input,
.dropdown .unity-text-element { color: rgb(224, 225, 201); }
.dropdown .unity-base-popup-field__input { background-color: rgb(38, 42, 42); }

/* Measured, not guessed: the theme lays the popup's own text element out as a 10.7-unit line box
   no matter how tall the field is, so the 14-unit font it inherits is drawn in a box too short
   for it and every selected value is cut in half ("fBm 团簇" read as a partial line in both
   captures). The box is 32 units inside this 34-unit field; a definite minimum is what the
   layout honours here. */
.dropdown .unity-base-popup-field__text,
.dropdown .unity-base-popup-field__input > .unity-text-element {
    min-height: 24px;
    -unity-text-align: middle-left;
}

.controls { height: 48px; flex-shrink: 0; align-items: flex-end; padding-top: 8px; }
.control {
    height: 40px;
    min-width: 82px;
    margin-right: 8px;
    background-color: rgb(75, 87, 84);
    color: rgb(222, 223, 199);
    border-width: 1px 1px 4px 1px;
    border-color: rgb(135, 144, 135) rgb(135, 144, 135) rgb(52, 61, 58) rgb(135, 144, 135);
    border-radius: 3px;
}
.control:hover { background-color: rgb(94, 108, 99); }
.primary { min-width: 106px; background-color: rgb(182, 183, 140); color: rgb(47, 64, 50); border-color: rgb(213, 211, 169) rgb(213, 211, 169) rgb(120, 129, 95) rgb(213, 211, 169); }
.danger { background-color: rgb(104, 80, 76); color: rgb(224, 181, 160); border-color: rgb(150, 118, 106) rgb(150, 118, 106) rgb(73, 62, 57) rgb(150, 118, 106); }
.speed-label { color: rgb(37, 58, 48); margin: 0 8px 13px 4px; }
.speed-slider { width: 150px; margin-bottom: 9px; }
.speed-value { color: rgb(37, 58, 48); width: 70px; margin: 0 8px 13px 8px; }
.spacer { flex-grow: 1; }
.footer { height: 36px; flex-shrink: 0; justify-content: space-between; align-items: flex-end; color: rgb(146, 151, 142); }
.plate { font-size: 10px; border-width: 1px; border-color: rgb(116, 124, 112); padding: 3px 7px; }

/* ===========================================================================
   Stage B: noise seeding. Deliberately compact -- the brief asks for five
   parameters and no noise editor, and every pixel spent here is a pixel the
   specimen archive loses. The archive keeps its own scroll region.
   =========================================================================== */
.seed-row { flex-direction: row; align-items: center; flex-shrink: 0; }

/* The field's own label is only a caption; the input is what has to show a value. The
   label used to take the free width and push the number into a sliver at the right. */
.seed-field { flex-grow: 1; height: 30px; margin: 0 6px 0 0; }
.seed-field .unity-base-field__label {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
    padding-right: 6px;
    color: rgb(224, 225, 201);
    font-size: 11px;
}
.seed-field .unity-base-text-field__input {
    background-color: rgb(38, 42, 42);
    border-width: 1px;
    border-color: rgb(141, 153, 140);
    color: rgb(224, 225, 201);
    font-size: 11px;
}

/* The seed number was unreadable in the Player: "20260915" came out as a thin band of glyph
   fragments. The field's height was never the problem -- the theme's own vertical padding on
   the editable text leaves a content box a few units tall, and the digits are clipped to it.
   The slider value fields below never had this because they zero the padding, which is why
   "0.32" and "40" were legible in the same captures while the seed was not. */
.seed-field .unity-base-text-field__input,
.seed-field .unity-base-text-field__input .unity-text-element {
    padding-top: 0;
    padding-bottom: 0;
}

.seed-button {
    width: 30px;
    height: 30px;
    margin: 0;
    padding: 0;
    background-color: rgb(75, 87, 84);
    color: rgb(222, 223, 199);
    border-width: 1px 1px 3px 1px;
    border-color: rgb(135, 144, 135) rgb(135, 144, 135) rgb(52, 61, 58) rgb(135, 144, 135);
    border-radius: 3px;
}
.seed-button:hover { background-color: rgb(94, 108, 99); }

.seed-slider { height: 22px; margin: 0; flex-shrink: 0; }

/* The column is 236 units wide. Without a capped width the slider's numeric field
   runs off the right edge and gets clipped, which is what the first capture showed. */
.seed-slider .unity-base-slider__label { color: rgb(37, 58, 48); min-width: 50px; font-size: 10px; }
.seed-slider .unity-base-slider__text-field { width: 46px; flex-grow: 0; flex-shrink: 0; }
.seed-slider .unity-base-slider__text-field .unity-base-text-field__input {
    background-color: rgb(38, 42, 42);
    color: rgb(224, 225, 201);
    font-size: 10px;
    padding: 0 2px;
}
.seed-slider .unity-base-slider__drag-container { margin-left: 2px; margin-right: 2px; }

/* The same defect as the dropdown values, in the text-input family: the theme lays the editable
   text out as an 8.6-unit line box whatever the field height is, so the 11-unit seed number and
   the sliders' own value boxes are cut. Measured: '20260915' needs 12.9 units of height inside
   the 30-unit seed field. */
.unity-text-element--inner-input-field-component {
    min-height: 18px;
    -unity-text-align: middle-left;
}

/* The seeding mode selector deliberately has NO height override. A 28-unit one cut the
   popup's own text box in half and the mode read as half a line of text in both captures;
   it now uses the same 34-unit height as the boundary and backend selectors. */

.seed-density { color: rgb(37, 58, 48); font-size: 10px; margin-top: 2px; flex-shrink: 0; }

.seed-actions { flex-direction: row; flex-shrink: 0; margin-top: 4px; }
.control-small {
    flex-grow: 1;
    height: 26px;
    min-width: 0;
    margin: 0 5px 0 0;
    font-size: 11px;
    background-color: rgb(75, 87, 84);
    color: rgb(222, 223, 199);
    border-width: 1px 1px 3px 1px;
    border-color: rgb(135, 144, 135) rgb(135, 144, 135) rgb(52, 61, 58) rgb(135, 144, 135);
    border-radius: 3px;
}
.control-small:hover { background-color: rgb(94, 108, 99); }
.control-small:disabled { background-color: rgb(62, 71, 68); color: rgb(130, 136, 128); }

/* ===========================================================================
   Narrow layout (the "compact" class is toggled from LifeTerminalController
   when the root's resolved width cannot host two columns).
   USS has no media queries - there is no @media and no width-based selector,
   so the switch MUST come from code watching GeometryChangedEvent.
   =========================================================================== */
.compact .workspace { flex-direction: column; }
.compact .display { flex-grow: 0; margin-right: 0; margin-bottom: 10px; min-width: 0; }

/* The grid must stay usable, but it is NOT what absorbs spare height here: in this layout the
   archive below it takes the slack, so the grid keeps a fixed floor rather than growing into a
   tall empty band. */
.compact .life-grid { flex-grow: 0; min-height: 300px; }

/* Kept at flex-grow 0 deliberately. Letting the library grow in the stacked layout
   made it start higher than the display's own height, and the archive title landed
   on top of the readouts. A little unused space at the bottom is the honest price
   of the two regions never overlapping. */
.compact .library { width: auto; flex-grow: 0; flex-direction: column; }

/* In the stacked layout the tool pages take a full row. The scrolling page is capped in
   height so it can never push the board or the shared controls around; what flows
   horizontally inside it is the content container, styled further down. */
.compact .tool-page { width: 100%; max-height: 320px; }
.compact .tool-page-seeding { max-height: 320px; }

/* The controls row is a single unwrapped flex row of fixed-width buttons. In a narrow panel it
   ran off the right edge and clipped "清空" entirely (visible in the 600x1000 capture). It must
   wrap instead, so every control stays reachable. */
.compact .controls {
    height: auto;
    flex-wrap: wrap;
    align-items: center;
    padding-top: 10px;
}
.compact .control { margin-bottom: 6px; }
.compact .speed-label { margin: 0 8px 6px 4px; }
.compact .speed-value { margin: 0 8px 6px 8px; }

/* The spacer exists to push 随机播种/清空 to the right in the wide layout. With wrapping it would
   consume a whole row and leave the trailing buttons stranded, so it collapses here. */
.compact .spacer { display: none; }

/* The header is also a single row; let the status line wrap under the title when narrow. */
.compact .header { height: auto; min-height: 64px; flex-wrap: wrap; }

.compact .section-title,
.compact .archive-note { width: 100%; }
.compact .preset-scroll { width: 100%; flex-grow: 1; min-height: 132px; }
.compact .field-label { width: 100%; }

/* 260 units is what "GPU（Compute Shader）" needs at font-size 10 with the field's own
   padding; at 180 the backend name was cut to "GPU（Compute Shade". */
.compact .dropdown { width: 260px; }

/* --- the seeding page in the stacked layout ------------------------------------
   The controls are direct children of the scroll view's content container (class
   "seed-page"), which is the element that has to become a wrapping row. Styling the
   scroll view left the container sizing itself to its widest child, so the whole panel
   sat in a ~220-unit column with the rest of the row empty. */
.compact .seed-page {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    width: 100%;
}
.compact .seed-page > .field-label { width: 100%; }

/* Mode and seed share the first line: the seed row takes whatever is left, so the number
   has room instead of being squeezed into a sliver. */
.compact .seed-mode { width: 200px; margin: 0 10px 6px 0; }
.compact .seed-row { flex-grow: 1; min-width: 240px; margin-bottom: 6px; }
.compact .seed-field { width: auto; flex-grow: 1; }

/* Two sliders per line at any panel width: a percentage wraps where a fixed width
   would either overflow a narrow window or waste a wide one. */
.compact .seed-slider { width: 48%; margin: 0 2% 6px 0; }
.compact .seed-density { width: 100%; }
.compact .seed-actions { width: 100%; }
.compact .seed-actions .control-small { flex-grow: 1; }
